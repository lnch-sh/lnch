{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lnch",
  "account_id": "03f5558f025d2c5826ad1bcda7ed66ad",
  "compatibility_date": "2026-10-24",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "TUNNEL", "class_name": "TunnelSession" },
      { "name": "DIRECTORY", "class_name": "TunnelDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TunnelSession", "TunnelDirectory"] }
  ],
  "routes": [
    { "pattern": "lnch.sh", "custom_domain": true },
    { "pattern": "www.lnch.sh", "custom_domain": true },
    // *.lnch.sh also reaches the tunnel once a proxied AAAA * record exists.
    // Wrangler custom domains cannot create that wildcard record.
    { "pattern": "*.lnch.sh/*", "zone_name": "lnch.sh" }
  ]
}
